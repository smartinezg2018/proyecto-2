{
  "name": "gestion-edificios",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix apps/api\" \"npm run dev --prefix apps/web\"",
    "install:all": "npm install --prefix apps/api && npm install --prefix apps/web",
    "db:migrate": "npm run db:migrate --prefix apps/api",
    "test": "npm test --prefix apps/api",
    "lint": "eslint apps/api apps/web",
    "lint:fix": "eslint apps/api apps/web --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3"
  }
}
